# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.
POSTGRES_USER=vacaciones
POSTGRES_PASSWORD=vacaciones_dev
POSTGRES_DB=vacaciones
POSTGRES_PORT=5433
DATABASE_URL="postgresql://vacaciones:vacaciones_dev@localhost:5433/vacaciones?schema=public"

# Secreto de Auth.js. Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Contraseña de los usuarios de DESARROLLO creados por `npm run db:seed`.
# Solo para desarrollo local; el seed se niega a ejecutarse con NODE_ENV=production.
SEED_PASSWORD=Dev-Vacaciones-2026!

# URL pública de la app. Obligatoria en producción (Auth.js rechaza hosts no declarados).
AUTH_URL="http://localhost:3000"

# Zona horaria de la empresa: define qué es "hoy" para las vacaciones.
APP_TIMEZONE="Europe/Madrid"
