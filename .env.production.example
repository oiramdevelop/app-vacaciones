# Plantilla para docker-compose.prod.yml. Cópiala a .env.production (NUNCA al repositorio) y cambia TODOS los valores.
POSTGRES_USER=vacaciones
# openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=CAMBIA-ESTO-por-una-contraseña-larga-y-aleatoria
POSTGRES_DB=vacaciones

# openssl rand -base64 32
AUTH_SECRET=

# Subdominio público (sin https://). Su registro DNS A debe apuntar a la IP de este servidor.
APP_DOMAIN=vacaciones.floramarket.es
# Email para Let's Encrypt (avisos de caducidad del certificado).
ACME_EMAIL=

APP_TIMEZONE=Europe/Madrid
